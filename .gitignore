# ---- heavy raw data (13 GB) - never commit ----
data/
# The source distribution includes only these three attributed capacity tables
# and their provenance. Raw archives and workbench databases stay local.
!/data/
/data/*
!/data/public/
/data/public/*
!/data/public/capacity_curves/
/data/public/capacity_curves/*
!/data/public/capacity_curves/batterylife-naion.csv
!/data/public/capacity_curves/batterylife-naion.json
!/data/public/capacity_curves/nims-additives.csv
!/data/public/capacity_curves/nims-additives.json
!/data/public/capacity_curves/nfm-temperature.csv
!/data/public/capacity_curves/nfm-temperature.json

# ---- external repos: vendored (Jackowska BSD 3-Clause, pinned commit 9f3b526, see README §11) ----
# tracked except the nested .git of the upstream clone
external/**/.git/

# ---- local workspace state ----
.workbuddy/
.mobius/
.venv/
结果/

# ---- handoff transfer artifact (rebuilt from repo at any time) ----
battery_platform_code_*.zip

# ---- python ----
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ---- generated outputs: keep only frozen small numeric tables ----
outputs/_golden_backup_protocol_reproduction/
outputs/_legacy_v02_step14/
outputs/baseline/
outputs/reproduction/
outputs/protocol_reproduction/
outputs/_legacy_*
outputs/fitting/
outputs/validation/
outputs/audit/
outputs/sensitivity/
outputs/platform/**/*.png
outputs/platform/**/*_Vt.png
outputs/analysis/**/cache/
outputs/analysis/targeted_sensitivity/*.npz
outputs/analysis/targeted_sensitivity/*.png
outputs/analysis/residual_atlas/*.png
# lfp_gitt_audit: keep small audit tables only; canonical previews + figs are regenerable by scripts/lfp_gitt_audit.py
outputs/analysis/lfp_gitt_audit/canonical_preview/
outputs/analysis/lfp_gitt_audit/*.png
# Phase A.5: per-run V(t) PNGs are regenerable; the comparison figure is kept
outputs/analysis/graphite_phaseA5/**/*_Vt.png
outputs/analysis/graphite_phaseB0/runs/**/*_Vt.png
outputs/analysis/graphite_phaseB05/runs/**/*_Vt.png
outputs/analysis/graphite_phaseB06/runs/**/*_Vt.png
outputs/analysis/graphite_phaseB1/runs/**/*_Vt.png
outputs/analysis/graphite_phaseB2/runs/**/*_Vt.png
# Phase B2: the per-D CC trajectory dump is large and regenerable; the
# summary tables and figures that carry the conclusion are kept
outputs/analysis/graphite_phaseB2/cc_rate_curves.csv
# 相位脚本的原始平台运行目录（scratch）：结论由各阶段目录下的报告、
# 汇总表和 runs/ 里的精选副本承载，这里不入库
outputs/analysis/*/platform_runs/
outputs/analysis/graphite_phaseB16/runs/**/*_Vt.png
# Local agent credentials must never enter version control.
data/agent_llm.local.json

# Local desktop packages and disposable workbench checks.
/outputs/fangzhen_workbench_ui_*/
/outputs/fangzhen_desktop*/
/outputs/battery_agent_*/
/outputs/workbench_*tests*/
/outputs/github_backend_probe_*/

# Disposable optional-engineering numerical probes.
/outputs/engineering_probe_*/

# Regenerable public-cell experiments, vendor copies and local desktop evidence.
/outputs/frontier_validation_*/

/outputs/adaptive_pf_*/

# Rebuildable desktop executables, Python bundles, and local build trees.
/outputs/fangzhen_workbench_*/

# Local release preparation, prediction QA, and deployment credentials.
/tmp/
/outputs/platform_unification_*/
/outputs/prediction_refinement_*/
/.env
/.env.*
!/.env.example
/deploy/**/.env
/deploy/**/administrator.json
