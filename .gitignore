# ---- heavy raw data (13 GB) - never commit ----
data/

# ---- external repos: vendored (Jackowska BSD 3-Clause, pinned commit 9f3b526, see README §11) ----
# tracked except the nested .git of the upstream clone
external/**/.git/

# ---- local workspace state ----
.workbuddy/
.mobius/
.venv/
结果/

# ---- handoff transfer artifact (rebuilt from repo at any time) ----
battery_platform_code_*.zip

# ---- python ----
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ---- generated outputs: keep only frozen small numeric tables ----
outputs/_golden_backup_protocol_reproduction/
outputs/_legacy_v02_step14/
outputs/baseline/
outputs/reproduction/
outputs/protocol_reproduction/
outputs/_legacy_*
outputs/fitting/
outputs/validation/
outputs/audit/
outputs/sensitivity/
outputs/platform/**/*.png
outputs/platform/**/*_Vt.png
outputs/analysis/**/cache/
outputs/analysis/targeted_sensitivity/*.npz
outputs/analysis/targeted_sensitivity/*.png
outputs/analysis/residual_atlas/*.png
# lfp_gitt_audit: keep small audit tables only; canonical previews + figs are regenerable by scripts/lfp_gitt_audit.py
outputs/analysis/lfp_gitt_audit/canonical_preview/
outputs/analysis/lfp_gitt_audit/*.png
# Phase A.5: per-run V(t) PNGs are regenerable; the comparison figure is kept
outputs/analysis/graphite_phaseA5/**/*_Vt.png
outputs/analysis/graphite_phaseB0/runs/**/*_Vt.png
outputs/analysis/graphite_phaseB05/runs/**/*_Vt.png
